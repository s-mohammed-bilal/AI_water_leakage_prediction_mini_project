# Load Excel Dataset
data <- read.csv("data/detection.csv")
library(shiny)
library(ggplot2)
library(dplyr)
library(DT)
library(caret)
library(readxl)
library(rpart)
# Load Excel Dataset
data <- read.csv("data/detection.csv")
# Convert to dataframe
data <- as.data.frame(data)
colnames(data) <- c("Timestamp","Sensor_ID","Pressure","Flow_Rate","Temperature")
# Feature Engineering: Water_Loss (as difference from average Flow Rate per sensor)
avg_flow <- data %>% group_by(Sensor_ID) %>% summarise(Avg_Flow = mean(Flow_Rate))
data <- left_join(data, avg_flow, by="Sensor_ID")
data$Water_Loss <- data$Flow_Rate - data$Avg_Flow
# Leakage label for ML (example: Water_Loss > 0.5 L/s is leakage)
data$Leakage <- ifelse(abs(data$Water_Loss) > 0.5,"Yes","No")
# Train ML Model (Decision Tree)
model <- train(
Leakage ~ Pressure + Flow_Rate + Temperature + Water_Loss,
data = data,
method = "rpart"
)
# UI
ui <- fluidPage(
titlePanel("AI Water Pipeline Leakage & Weakness Prediction"),
sidebarLayout(
sidebarPanel(
selectInput("sensor", "Sensor ID", choices=unique(data$Sensor_ID)),
numericInput("flow", "Flow Rate (L/s)", value=1.2, min=0),
numericInput("pressure", "Pressure (bar)", value=3.0, min=0),
numericInput("temperature", "Temperature (°C)", value=25, min=0),
actionButton("predictBtn", "Predict Leakage"),
hr(),
h4("Prediction Result:"),
textOutput("prediction"),
textOutput("pipe_status")
),
mainPanel(
tabsetPanel(
tabPanel("Dataset", DT::dataTableOutput("table")),
tabPanel("Flow Rate Distribution", plotOutput("flowDist")),
tabPanel("Pressure Distribution", plotOutput("pressureDist")),
tabPanel("Water Loss Distribution", plotOutput("lossDist"))
)
)
)
)
# Server
server <- function(input, output, session) {
# Show Dataset
output$table <- DT::renderDataTable({
DT::datatable(data)
})
# Flow Rate Distribution
output$flowDist <- renderPlot({
ggplot(data, aes(Flow_Rate)) +
geom_histogram(binwidth=0.1, fill="blue", alpha=0.6) +
geom_density(aes(y=0.1*..count..), color="red", size=1) +
ggtitle("Flow Rate Distribution") +
xlab("Flow Rate (L/s)") + ylab("Count")
})
# Pressure Distribution
output$pressureDist <- renderPlot({
ggplot(data, aes(Pressure)) +
geom_histogram(binwidth=0.2, fill="green", alpha=0.6) +
geom_density(aes(y=0.2*..count..), color="red", size=1) +
ggtitle("Pressure Distribution") +
xlab("Pressure (bar)") + ylab("Count")
})
# Water Loss Distribution
output$lossDist <- renderPlot({
ggplot(data, aes(Water_Loss)) +
geom_histogram(binwidth=0.1, fill="orange", alpha=0.6) +
geom_density(aes(y=0.1*..count..), color="red", size=1) +
ggtitle("Water Loss Distribution") +
xlab("Water Loss (L/s)") + ylab("Count")
})
# Predict Leakage on Button Click
observeEvent(input$predictBtn, {
# Calculate Water_Loss for this sensor input
avg_flow_sensor <- avg_flow$Avg_Flow[avg_flow$Sensor_ID == input$sensor]
water_loss_input <- input$flow - avg_flow_sensor
new_data <- data.frame(
Pressure = input$pressure,
Flow_Rate = input$flow,
Temperature = input$temperature,
Water_Loss = water_loss_input
)
pred <- predict(model, new_data)
output$prediction <- renderText({
paste("Leakage Prediction:", pred)
})
output$pipe_status <- renderText({
if(abs(water_loss_input) > 0.5){
"Pipe Condition: WEAK"
} else {
"Pipe Condition: NORMAL"
}
})
})
}
# Run App
shinyApp(ui, server)
