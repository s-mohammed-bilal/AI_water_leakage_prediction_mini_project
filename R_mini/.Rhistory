library(shiny)
library(ggplot2)
library(dplyr)
library(DT)
library(caret)
library(readxl)
library(rpart)
# Load Dataset
data <- read.csv("data/detection.csv")
# Fix column names
colnames(data) <- c(
"Timestamp",
"Sensor_ID",
"Pressure",
"Flow_Rate",
"Temperature"
)
data <- as.data.frame(data)
# Feature Engineering
avg_flow <- data %>%
group_by(Sensor_ID) %>%
summarise(Avg_Flow = mean(Flow_Rate))
data <- left_join(data, avg_flow, by="Sensor_ID")
data$Water_Loss <- data$Flow_Rate - data$Avg_Flow
# Better Leakage rule
data$Leakage <- ifelse(abs(data$Water_Loss) > 1,"Yes","No")
# Train Model
model <- train(
Leakage ~ Pressure + Flow_Rate + Temperature + Water_Loss,
data = data,
method = "rpart"
)
ui <- fluidPage(
titlePanel("AI Water Pipeline Leakage Prediction"),
sidebarLayout(
sidebarPanel(
selectInput("sensor","Sensor ID",choices=unique(data$Sensor_ID)),
numericInput("flow","Flow Rate",1.2),
numericInput("pressure","Pressure",3),
numericInput("temperature","Temperature",25),
actionButton("predictBtn","Predict")
),
mainPanel(
tabsetPanel(
tabPanel("Dataset",DTOutput("table")),
tabPanel("Flow Distribution",
plotOutput("flowDist")),
tabPanel("Pressure Distribution",
plotOutput("pressureDist"))
)
)
)
)
server <- function(input, output) {
output$table <- renderDT({
datatable(data)
})
output$flowDist <- renderPlot({
ggplot(data,aes(Flow_Rate))+
geom_histogram(binwidth=0.1,fill="blue")
})
output$pressureDist <- renderPlot({
ggplot(data,aes(Pressure))+
geom_histogram(binwidth=0.2,fill="green")
})
observeEvent(input$predictBtn,{
avg_flow_sensor <- avg_flow$Avg_Flow[
avg_flow$Sensor_ID==input$sensor]
water_loss_input <- input$flow - avg_flow_sensor
new_data <- data.frame(
Pressure=input$pressure,
Flow_Rate=input$flow,
Temperature=input$temperature,
Water_Loss=water_loss_input
)
pred <- predict(model,new_data)
showModal(modalDialog(
paste("Leakage Prediction:",pred)
))
})
}
shinyApp(ui,server)
shiny::runApp()
runApp()
shiny::runApp()
runApp()
